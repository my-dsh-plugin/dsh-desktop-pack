{
  "name": "dsh-desktop-pack",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 桌面客户端打包工程：harness 外部动态引入，预置模式与插件，macOS/Windows 双平台。",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "sources:fetch": "node scripts/fetch-sources.mjs",
    "sources:verify": "node scripts/fetch-sources.mjs --verify",
    "fetch:node": "node scripts/fetch-node.mjs",
    "build:harness": "node scripts/build-harness.mjs",
    "package:harness": "node scripts/package-harness.mjs",
    "build:plugins": "node scripts/build-plugins.mjs",
    "assemble:seed": "node scripts/assemble-seed.mjs",
    "package:runtime": "node scripts/package-runtime.mjs",
    "shell:build": "node scripts/build-shell.mjs",
    "icon:generate": "node scripts/generate-icons.mjs",
    "package:dist": "node scripts/package-dist.mjs",
    "build": "node scripts/build.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.11.4"
  }
}
