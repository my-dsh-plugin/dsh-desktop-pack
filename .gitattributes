# Normalize line endings: text stored as LF, checked out per platform rules.
* text=auto

# Force LF for cross-platform text formats (CI bash + node toolchain).
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Binary files: never touch.
*.png binary
*.icns binary
*.ico binary
