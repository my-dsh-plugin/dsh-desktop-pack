      "packageName": "dsh-session-archive-manager",
      "bundleName": "dsh-session-archive-manager",
      "build": {
        "install": ["pnpm", "install", "--frozen-lockfile"],
        "command": ["pnpm", "build"]
      }
    },
    {
      "id": "agent-mode-switcher",
      "kind": "git",
      "repo": "https://github.com/my-dsh-plugin/agent-mode-switcher",
